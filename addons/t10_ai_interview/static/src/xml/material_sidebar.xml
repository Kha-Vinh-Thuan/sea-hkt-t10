<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="t10_ai_interview.MaterialSidebar" t-inherit="web.NavBar" t-inherit-mode="extension">
        <xpath expr="//header[hasclass('o_navbar')]" position="attributes">
            <attribute name="t-att-class">{'aho-sidebar-collapsed': this.state.ahoSidebarCollapsed and this.currentApp?.xmlid === 'hr_recruitment.menu_hr_recruitment_root'}</attribute>
        </xpath>
        <xpath expr="//div[hasclass('o_menu_systray')]" position="before">
            <t t-if="this.currentApp?.xmlid === 'hr_recruitment.menu_hr_recruitment_root'">
                <div class="aho-sidebar-brand">
                    <t t-set="aiHome" t-value="this.findAhoMenu('t10_ai_interview.menu_ai_pipeline')"/>
                    <a t-att-href="aiHome ? this.getMenuItemHref(aiHome) : '/odoo'" class="aho-brand-link" aria-label="AI Hiring Operator - Theo dõi ứng viên">
                        <img src="/t10_ai_interview/static/src/img/ai-hiring-operator.svg?v=2" alt="" width="40" height="40"/>
                        <span class="aho-brand-copy">
                            <strong>AI Hiring</strong>
                            <span>Operator</span>
                        </span>
                    </a>
                    <div class="aho-brand-caption">Điều phối tuyển dụng</div>
                </div>
                <button class="aho-sidebar-toggle" t-on-click="() => this.toggleAhoSidebar()"
                        t-att-aria-expanded="!this.state.ahoSidebarCollapsed"
                        t-att-aria-label="this.state.ahoSidebarCollapsed ? 'Mở thanh điều hướng' : 'Thu gọn thanh điều hướng'"
                        t-att-title="this.state.ahoSidebarCollapsed ? 'Mở thanh điều hướng' : 'Thu gọn thanh điều hướng'">
                    <i class="oi" t-att-data-icon="this.state.ahoSidebarCollapsed ? 'chevron_right' : 'chevron_left'" aria-hidden="true"/>
                    <span>Thu gọn</span>
                </button>
                <nav class="aho-sidebar-menu" aria-label="Điều hướng tuyển dụng">
                    <div class="aho-sidebar-section-label">01 / QUY TRÌNH</div>
                    <t t-call="t10_ai_interview.MaterialSidebarEntry" menu="this.findAhoMenu('hr_recruitment.menu_hr_job_position') || this.findAhoMenu('hr_recruitment.menu_hr_job_position_interviewer')" label="'Vị trí tuyển dụng'" icon="'work'"/>
                    <t t-call="t10_ai_interview.MaterialSidebarEntry" menu="this.findAhoMenu('t10_ai_interview.menu_ai_pipeline')" label="'Theo dõi ứng viên'" icon="'groups'"/>
                    <t t-call="t10_ai_interview.MaterialSidebarEntry" menu="this.findAhoMenu('rag_interview_agent.menu_rag_interview')" label="'Phỏng vấn AI'" icon="'forum'"/>
                    <div class="aho-sidebar-section-label aho-sidebar-section-gap">02 / HỒ SƠ</div>
                    <t t-call="t10_ai_interview.MaterialSidebarEntry" menu="this.findAhoMenu('hr_recruitment.menu_crm_case_categ_all_app')" label="'Tất cả hồ sơ'" icon="'description'"/>
                    <t t-call="t10_ai_interview.MaterialSidebarEntry" menu="this.findAhoMenu('hr_recruitment.menu_hr_talent_pools')" label="'Kho ứng viên'" icon="'inventory_2'"/>
                </nav>
                <div class="aho-sidebar-footnote">AI hỗ trợ · Người tuyển quyết định</div>
            </t>
        </xpath>
    </t>

    <t t-name="t10_ai_interview.MaterialSidebarEntry">
        <a t-if="menu"
           t-att-href="this.getMenuItemHref(menu)"
           t-att-class="{'aho-sidebar-link': true, 'aho-active': this.isSidebarMenuActive(menu)}"
           t-att-aria-current="this.isSidebarMenuActive(menu) ? 'page' : undefined"
           t-att-data-menu-xmlid="menu.xmlid"
           t-on-click.prevent="() => this._onMenuClicked(menu)">
            <i class="oi" t-att-data-icon="icon" aria-hidden="true"/>
            <span t-out="label"/>
        </a>
    </t>
    <t t-name="t10_ai_interview.PipelineViewSwitcher" t-inherit="web.ControlPanel" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('o_switch_view')]" position="inside">
            <span t-if="this.env.searchModel?.context?.aho_pipeline and ['kanban', 'list'].includes(view.type)" class="ms-1">
                <t t-out="view.type === 'kanban' ? 'Thẻ' : 'Danh sách'"/>
            </span>
        </xpath>
        <xpath expr="//button[hasclass('o_switch_view')]" position="attributes">
            <attribute name="t-att-data-tooltip">this.env.searchModel?.context?.aho_pipeline ? (view.type === 'kanban' ? 'Thẻ' : 'Danh sách') : view.name</attribute>
            <attribute name="t-att-aria-label">this.env.searchModel?.context?.aho_pipeline ? (view.type === 'kanban' ? 'Thẻ' : 'Danh sách') : view.name + ' View'</attribute>
        </xpath>
    </t>
</templates>
