<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="t10_ai_interview.MaterialSidebar" t-inherit="web.NavBar" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_menu_systray')]" position="before">
            <t t-if="this.currentApp?.xmlid === 'hr_recruitment.menu_hr_recruitment_root'">
                <div class="aho-sidebar-brand">
                    <t t-set="aiHome" t-value="this.currentAppSections.find((section) => section.xmlid === 't10_ai_interview.menu_ai_root')?.childrenTree?.find((child) => child.xmlid === 't10_ai_interview.menu_ai_pipeline')"/>
                    <a t-att-href="aiHome ? this.getMenuItemHref(aiHome) : '/odoo'" class="aho-brand-link" aria-label="AI Hiring Operator - Ứng viên">
                        <img src="/t10_ai_interview/static/src/img/ai-hiring-operator.svg" alt="" width="42" height="42"/>
                        <span class="aho-brand-copy">
                            <strong>AI Hiring</strong>
                            <span>Operator</span>
                        </span>
                    </a>
                    <div class="aho-brand-caption">Recruitment workspace</div>
                </div>
                <div class="aho-sidebar-label">WORKSPACE</div>
                <ul class="aho-sidebar-menu" role="menu" aria-label="Recruitment navigation">
                    <t t-foreach="this.currentAppSections" t-as="section" t-key="section.id">
                        <t t-call="t10_ai_interview.MaterialSidebarEntry" section="section"/>
                    </t>
                </ul>
            </t>
        </xpath>
    </t>

    <t t-name="t10_ai_interview.MaterialSidebarEntry">
        <li t-if="section.childrenTree.length" class="aho-sidebar-group">
            <div class="aho-sidebar-group-title">
                <span class="aho-group-icon" aria-hidden="true"/>
                <t t-out="section.name"/>
            </div>
            <ul class="aho-sidebar-submenu">
                <t t-foreach="section.childrenTree" t-as="child" t-key="child.id">
                    <t t-call="t10_ai_interview.MaterialSidebarEntry" section="child"/>
                </t>
            </ul>
        </li>
        <li t-else="" class="aho-sidebar-item">
            <a t-att-href="this.getMenuItemHref(section)"
               t-att-class="{'aho-active': this.isSidebarMenuActive(section)}"
               t-att-aria-current="this.isSidebarMenuActive(section) ? 'page' : undefined"
               t-att-data-menu-xmlid="section.xmlid"
               t-on-click.prevent="() => this._onMenuClicked(section)"
               role="menuitem">
                <span class="aho-nav-marker" aria-hidden="true"/>
                <span t-out="section.name"/>
            </a>
        </li>
    </t>
</templates>
