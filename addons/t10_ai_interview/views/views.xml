<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Keep the project-facing Odoo labels consistent without changing their actions. -->
    <record id="hr_recruitment.action_hr_job" model="ir.actions.act_window"><field name="name">Vị trí tuyển dụng</field></record>
    <record id="hr_recruitment.action_hr_job_interviewer" model="ir.actions.act_window"><field name="name">Vị trí tuyển dụng</field></record>
    <record id="hr_recruitment.crm_case_categ0_act_job" model="ir.actions.act_window"><field name="name">Tất cả hồ sơ</field></record>
    <record id="hr_recruitment.action_hr_talent_pool" model="ir.actions.act_window"><field name="name">Kho ứng viên</field></record>
    <record id="hr_recruitment.menu_hr_job_position" model="ir.ui.menu"><field name="name">Vị trí tuyển dụng</field></record>
    <record id="hr_recruitment.menu_hr_job_position_interviewer" model="ir.ui.menu"><field name="name">Vị trí tuyển dụng</field></record>
    <record id="hr_recruitment.menu_crm_case_categ_all_app" model="ir.ui.menu"><field name="name">Tất cả hồ sơ</field></record>
    <record id="hr_recruitment.menu_hr_talent_pools" model="ir.ui.menu"><field name="name">Kho ứng viên</field></record>

    <!-- ============ Job: pipeline config + learning ============ -->
    <record id="hr_job_form_ai" model="ir.ui.view">
        <field name="name">hr.job.form.ai</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr.view_hr_job_form"/>
        <field name="arch" type="xml">
            <header position="inside">
                <button name="action_ai_upload_cvs" type="object" string="Thêm CV" class="btn-primary"
                        invisible="not ai_enabled" groups="hr_recruitment.group_hr_recruitment_user"/>
                <button name="action_ai_screen_existing" type="object" string="AI Screen Existing Applicants"
                        invisible="not ai_enabled" groups="base.group_no_one"/>
            </header>
            <notebook position="inside">
                <page string="AI Effectiveness" name="ai_effectiveness" invisible="not ai_enabled"
                      groups="base.group_no_one">
                    <p class="text-muted">Each metric checks an agent's output against what happened next. Low agreement or a high override rate means the playbook needs tuning: use "Propose Improvements Now".</p>
                    <group>
                        <group string="Filter">
                            <field name="ai_filter_precision" widget="progressbar"/>
                            <field name="ai_filter_override_rate" widget="progressbar"/>
                        </group>
                        <group string="Schedule">
                            <field name="ai_booking_rate" widget="progressbar"/>
                            <field name="ai_no_show_rate" widget="progressbar"/>
                            <field name="ai_hours_to_book" widget="float_time"/>
                        </group>
                        <group string="Interview">
                            <field name="ai_completion_rate" widget="progressbar"/>
                        </group>
                        <group string="Report">
                            <field name="ai_agreement_rate" widget="progressbar"/>
                            <field name="ai_gray_rate" widget="progressbar"/>
                        </group>
                        <group string="Pipeline">
                            <field name="ai_candidate_count"/>
                            <field name="ai_hours_to_report" widget="float_time"/>
                            <field name="ai_cost_per_candidate"/>
                        </group>
                    </group>
                    <separator string="Models: quality vs cost (★ = current champion)"/>
                    <field name="ai_model_board" nolabel="1"/>
                </page>
                <page string="Thiết lập AI" name="ai_pipeline" groups="hr_recruitment.group_hr_recruitment_user">
                    <p class="text-muted">Bật quy trình AI cho vị trí này, sau đó thêm CV. Các tiêu chí và câu hỏi bên dưới sẽ được dùng để xử lý ứng viên của vị trí.</p>
                    <group>
                        <group string="Cấu hình quy trình">
                            <field name="ai_enabled"/>
                            <field name="ai_max_turns" invisible="not ai_enabled"/>
                            <field name="ai_industry" invisible="not ai_enabled"/>
                            <field name="ai_filter_threshold" invisible="not ai_enabled" groups="base.group_no_one"/>
                            <field name="ai_slot_minutes" invisible="not ai_enabled" groups="base.group_no_one"/>
                            <field name="ai_join_anytime" invisible="not ai_enabled" groups="base.group_no_one"/>
                        </group>
                        <group string="Models (via 9router)" invisible="not ai_enabled" groups="base.group_no_one">
                            <field name="ai_model_filter"/>
                            <field name="ai_model_schedule"/>
                            <field name="ai_model_report"/>
                            <field name="ai_model_auto"/>
                        </group>
                        <group string="Learning" invisible="not ai_enabled" groups="base.group_no_one">
                            <field name="ai_playbook_version"/>
                            <button name="action_ai_improve" type="object" class="btn-secondary" colspan="2"
                                    string="Propose Improvements Now"
                                    help="Compare AI suggestions with recruiter decisions and draft a better playbook."/>
                        </group>
                    </group>
                    <group invisible="not ai_enabled">
                        <field name="ai_questions"/>
                        <field name="ai_rubric"/>
                        <field name="ai_must_have" groups="base.group_no_one" placeholder="e.g. 3+ years Python, has shipped a production web app, English B2"/>
                    </group>
                    <field name="ai_proposal_ids" invisible="not ai_enabled" groups="base.group_no_one">
                        <list create="0">
                            <field name="create_date" string="Date"/>
                            <field name="base_version"/>
                            <field name="sample_size"/>
                            <field name="agreement_before"/>
                            <field name="state" widget="badge"
                                   decoration-info="state == 'proposed'" decoration-success="state == 'approved'"/>
                        </list>
                        <form>
                            <header>
                                <button name="action_approve" type="object" string="Approve and Apply"
                                        class="btn-primary" invisible="state != 'proposed'"/>
                                <button name="action_reject" type="object" string="Reject" invisible="state != 'proposed'"/>
                                <field name="state" widget="statusbar"/>
                            </header>
                            <group>
                                <field name="agreement_before"/>
                                <field name="rationale"/>
                                <field name="filter_threshold" readonly="state != 'proposed'"/>
                                <field name="must_have" readonly="state != 'proposed'"/>
                                <field name="questions" readonly="state != 'proposed'"/>
                                <field name="rubric" readonly="state != 'proposed'"/>
                            </group>
                        </form>
                    </field>
                </page>
            </notebook>
        </field>
    </record>

    <!-- ============ CV upload wizard ============ -->
    <record id="cv_upload_form" model="ir.ui.view">
        <field name="name">t10.ai.cv.upload.form</field>
        <field name="model">t10.ai.cv.upload</field>
        <field name="arch" type="xml">
            <form>
                <p class="text-muted">Chọn CV dạng PDF, ảnh hoặc văn bản. Mỗi tệp tạo một hồ sơ; AI trích thông tin để người tuyển kiểm tra.</p>
                <group>
                    <field name="job_id" readonly="1"/>
                    <field name="attachment_ids" widget="many2many_binary"/>
                </group>
                <footer>
                    <button name="action_upload" type="object" string="Thêm CV và bắt đầu lọc" class="btn-primary"/>
                    <button special="cancel" string="Hủy"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ============ Applicant ============ -->
    <record id="hr_applicant_form_ai" model="ir.ui.view">
        <field name="name">hr.applicant.form.ai</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='archive_applicant']" position="before">
                <button string="Mở phỏng vấn ngay (demo)" name="action_ai_interview_now" type="object" class="btn-secondary"
                        icon="fa-microphone" help="Mở phòng phỏng vấn ngay và bỏ qua bước lọc CV, đặt lịch."
                        invisible="not active or ai_step in ('interviewed', 'reported', 'decided')"/>
                <button string="Duyệt sang vòng tiếp" name="action_ai_approve" type="object" class="btn-primary"
                        invisible="ai_step != 'reported'"/>
                <button string="Từ chối" name="action_ai_reject" type="object" invisible="ai_step != 'reported'"/>
                <button string="Cho phỏng vấn dù chưa đạt lọc CV" name="action_ai_override_filter" type="object"
                        invisible="ai_step != 'screened_out'"/>
                <button string="Đổi lịch" name="action_ai_reschedule" type="object"
                        invisible="ai_step not in ('scheduled', 'scheduling', 'no_show')"/>
                <button string="Thử lại bước AI" name="action_ai_retry" type="object" invisible="ai_step != 'error'"/>
                <button string="Start AI Pipeline" name="action_ai_start" type="object"
                        invisible="ai_step or not active" groups="base.group_no_one"/>
            </xpath>
            <xpath expr="//header/button[@name='archive_applicant']" position="attributes">
                <attribute name="string">Từ chối hồ sơ</attribute>
                <attribute name="invisible">not active or is_pool_applicant or ai_step == 'reported'</attribute>
            </xpath>
            <xpath expr="//header/button[@name='action_talent_pool_add_applicants']" position="attributes">
                <attribute name="string">Thêm vào kho ứng viên</attribute>
            </xpath>
            <xpath expr="//div[hasclass('oe_title')]/label[@for='partner_name']" position="attributes">
                <attribute name="string">Ứng viên</attribute>
            </xpath>
            <xpath expr="//sheet//field[@name='job_id']" position="attributes">
                <attribute name="string">Vị trí tuyển dụng</attribute>
                <attribute name="placeholder">Ứng tuyển tự do</attribute>
            </xpath>
            <xpath expr="//sheet//field[@name='recruiter_id']" position="attributes">
                <attribute name="string">HR phụ trách</attribute>
                <attribute name="placeholder">Chưa phân công</attribute>
            </xpath>
            <xpath expr="//sheet//field[@name='interviewer_ids']" position="attributes">
                <attribute name="string">Người phỏng vấn</attribute>
                <attribute name="placeholder">Chọn người phỏng vấn</attribute>
            </xpath>
            <xpath expr="//sheet//field[@name='categ_ids']" position="attributes">
                <attribute name="string">Nhãn</attribute>
                <attribute name="placeholder">Ví dụ: tiềm năng</attribute>
            </xpath>
            <xpath expr="//notebook" position="before">
                <div class="alert alert-info mb-2" role="status" invisible="not ai_step">
                    <div class="d-flex gap-4 flex-wrap">
                        <span><b>Trạng thái AI:</b> <field name="ai_step" readonly="1" class="d-inline"/></span>
                        <span invisible="not ai_interview_start"><b>Lịch phỏng vấn:</b> <field name="ai_interview_start" readonly="1" class="d-inline"/></span>
                        <span invisible="not ai_match_score"><b>Đối chiếu CV:</b> <field name="ai_match_score" readonly="1" class="d-inline"/>/100</span>
                        <span invisible="not ai_score"><b>Kết quả phỏng vấn:</b> <field name="ai_score" readonly="1" class="d-inline"/>/100</span>
                    </div>
                    <div class="mt-2"><b>Việc tiếp theo:</b> <field name="ai_next_action" readonly="1" class="d-inline"/></div>
                    <div class="mt-2" invisible="not ai_recommendation"><b>AI đề xuất:</b>
                        <field name="ai_recommendation" readonly="1" widget="badge" class="d-inline"
                               decoration-success="ai_recommendation == 'approve'" decoration-danger="ai_recommendation == 'reject'"/>
                        <field name="ai_verdict" readonly="1" class="d-inline text-muted"/>
                    </div>
                </div>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Kết quả AI" name="ai_pipeline" invisible="not ai_step">
                    <group string="Review nhanh cho người phụ trách" invisible="ai_step not in ('reported', 'decided')">
                        <field name="ai_summary" readonly="1" invisible="not ai_summary" string="Tóm tắt do AI tạo"/>
                        <field name="ai_match_summary" readonly="1" invisible="not ai_match_summary" string="Bằng chứng đối chiếu CV"/>
                        <field name="ai_verify_claims" readonly="1" invisible="not ai_verify_claims" string="Điều cần xác minh"/>
                        <field name="ai_feedback" string="Ghi chú kiểm tra AI" placeholder="Ghi điều AI hiểu sai, bằng chứng còn thiếu hoặc câu hỏi cho vòng tiếp."/>
                    </group>
                    <div class="text-muted mb-2" invisible="ai_step not in ('reported', 'decided') or ai_summary">
                        Chưa có bản tóm tắt phỏng vấn trong hồ sơ này; xem bằng chứng CV và transcript hiện có.
                    </div>
                    <div class="text-muted mb-3" invisible="ai_step not in ('reported', 'decided')">
                        Tóm tắt và điểm AI là thông tin tham khảo. Xem CV, transcript và nhận xét người phỏng vấn trước khi quyết định.
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="not ai_integrity_summary or ai_integrity_score &gt;= 80">
                        <b>Tín hiệu phỏng vấn cần kiểm tra (<field name="ai_integrity_score" readonly="1" class="d-inline"/>/100):</b>
                        <field name="ai_integrity_summary" readonly="1" class="d-inline"/>
                    </div>
                    <group string="Bằng chứng để người phụ trách xem xét">
                        <field name="ai_match_summary" readonly="1" invisible="not ai_match_summary or ai_step in ('reported', 'decided')"/>
                        <field name="ai_verify_claims" readonly="1" invisible="not ai_verify_claims or ai_step in ('reported', 'decided')"/>
                        <field name="ai_human_decision" readonly="1" invisible="not ai_human_decision"/>
                    </group>
                    <group>
                        <field name="ai_integrity_score" widget="progressbar" readonly="1" invisible="not ai_integrity_summary"/>
                        <field name="ai_integrity_summary" readonly="1" invisible="not ai_integrity_summary"/>
                        <field name="ai_summary" readonly="1" invisible="not ai_summary or ai_step in ('reported', 'decided')"/>
                        <field name="ai_transcript_text" readonly="1" invisible="not ai_transcript_text"/>
                        <field name="ai_feedback" invisible="ai_step != 'screened_out'"
                               placeholder="Ghi lại điều AI hiểu sai hoặc bằng chứng cần xem thêm."/>
                    </group>
                    <group groups="base.group_no_one">
                        <group string="Filter">
                            <field name="ai_match_score" widget="progressbar" readonly="1"/>
                            <field name="ai_filter_override" readonly="1" invisible="not ai_filter_override"/>
                        </group>
                        <group string="Schedule">
                            <field name="ai_session_id" readonly="1"/>
                            <field name="ai_join_url" widget="CopyClipboardChar" invisible="not ai_join_url"/>
                            <field name="ai_cost" readonly="1"/>
                            <field name="ai_url" widget="CopyClipboardChar" invisible="not ai_url"/>
                            <field name="ai_event_id" readonly="1"/>
                            <field name="ai_reschedule_count" readonly="1"/>
                        </group>
                    </group>
                    <field name="ai_log_ids" readonly="1" groups="base.group_no_one">
                        <list>
                            <field name="create_date" string="When"/>
                            <field name="agent" widget="badge"/>
                            <field name="to_agent" widget="badge"/>
                            <field name="message"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="hr_applicant_kanban_ai" model="ir.ui.view">
        <field name="name">hr.applicant.kanban.ai</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_kanban_view_applicant"/>
        <field name="arch" type="xml">
            <xpath expr="//t[@t-name='card']//field[@name='categ_ids']" position="before">
                <div t-if="record.ai_step.raw_value" class="aho-candidate-ai">
                    <div class="aho-candidate-status">
                        <span class="aho-card-label">Bước AI</span>
                        <field name="ai_step" widget="badge"
                               decoration-warning="ai_step in ('scheduling', 'no_show', 'reported')"
                               decoration-danger="ai_step == 'error'"
                               decoration-success="ai_step == 'decided'"/>
                    </div>
                    <div class="aho-candidate-next">
                        <span class="aho-card-label">Việc tiếp theo</span>
                        <field name="ai_next_action"/>
                    </div>
                    <div class="aho-candidate-owner" t-if="record.recruiter_id.raw_value">
                        <span class="aho-card-label">HR phụ trách</span>
                        <field name="recruiter_id"/>
                    </div>
                    <div class="aho-candidate-status" t-if="record.ai_recommendation.raw_value">
                        <span class="aho-card-label">AI gợi ý</span>
                        <field name="ai_recommendation" widget="badge"
                               decoration-success="ai_recommendation == 'approve'" decoration-danger="ai_recommendation == 'reject'"/>
                    </div>
                    <div class="aho-candidate-scores" t-if="record.ai_match_score.raw_value or record.ai_score.raw_value">
                        <span t-if="record.ai_match_score.raw_value">Khớp CV: <field name="ai_match_score"/>/100</span>
                        <span t-if="record.ai_score.raw_value">Phỏng vấn AI: <field name="ai_score"/>/100</span>
                        <span class="aho-card-label">Điểm tham khảo</span>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="hr_applicant_list_ai" model="ir.ui.view">
        <field name="name">hr.applicant.list.ai</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.crm_case_tree_view_job"/>
        <field name="arch" type="xml">
            <field name="kanban_state" position="after">
                <field name="ai_step" optional="show" widget="badge"/>
                <field name="ai_match_score" optional="show"/>
                <field name="ai_score" optional="show"/>
                <field name="ai_recommendation" optional="show" widget="badge"
                       decoration-success="ai_recommendation == 'approve'" decoration-danger="ai_recommendation == 'reject'"/>
            </field>
        </field>
    </record>

    <!-- ============ AI Pipeline board ============ -->
    <record id="hr_applicant_list_ai_pipeline" model="ir.ui.view">
        <field name="name">hr.applicant.list.ai.pipeline</field>
        <field name="model">hr.applicant</field>
        <field name="arch" type="xml">
            <list string="Theo dõi ứng viên" class="aho-ai-pipeline-list" create="0" default_order="write_date desc">
                <field name="partner_name" width="[150]" string="Ứng viên"/>
                <field name="job_id" width="[160]" string="Vị trí"/>
                <field name="stage_id" width="[130]" string="Giai đoạn tuyển dụng"/>
                <field name="ai_step" width="[150]" string="Bước AI" widget="badge"
                       decoration-warning="ai_step in ('scheduling', 'no_show', 'reported')"
                       decoration-danger="ai_step == 'error'"
                       decoration-success="ai_step == 'decided'"/>
                <field name="ai_next_action" width="[220]" string="Việc tiếp theo" optional="show"/>
                <field name="recruiter_id" width="[150]" string="Người phụ trách" widget="many2one_avatar_employee" optional="show"/>
                <field name="ai_interview_start" string="Lịch phỏng vấn" optional="show"/>
                <field name="activity_date_deadline" string="Hạn xử lý" optional="show"/>
                <field name="ai_recommendation" string="AI đề xuất" widget="badge" optional="hide"/>
                <field name="talent_pool_ids" string="Kho ứng viên" widget="many2many_tags" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="hr_applicant_search_ai_pipeline" model="ir.ui.view">
        <field name="name">hr.applicant.search.ai.pipeline</field>
        <field name="model">hr.applicant</field>
        <field name="arch" type="xml">
            <search string="Tìm ứng viên AI">
                <field name="partner_name" string="Ứng viên"/>
                <field name="job_id" string="Vị trí"/>
                <field name="recruiter_id" string="Người phụ trách"/>
                <filter name="needs_review" string="Cần người duyệt" domain="[('ai_step', '=', 'reported')]"/>
                <filter name="needs_schedule" string="Cần xử lý lịch" domain="[('ai_step', 'in', ['scheduling', 'no_show'])]"/>
                <filter name="needs_retry" string="Lỗi AI" domain="[('ai_step', '=', 'error')]"/>
                <filter name="decided" string="Đã quyết định" domain="[('ai_step', '=', 'decided')]"/>
                <group>
                    <filter name="group_ai_step" string="Bước AI" context="{'group_by': 'ai_step'}"/>
                    <filter name="group_stage" string="Giai đoạn tuyển dụng" context="{'group_by': 'stage_id'}"/>
                    <filter name="group_job" string="Vị trí" context="{'group_by': 'job_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ai_pipeline" model="ir.actions.act_window">
        <field name="name">Theo dõi ứng viên</field>
        <field name="res_model">hr.applicant</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="view_id" ref="hr_applicant_list_ai_pipeline"/>
        <field name="search_view_id" ref="hr_applicant_search_ai_pipeline"/>
        <field name="domain">[('ai_step', '!=', False)]</field>
        <field name="context">{'aho_pipeline': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Chưa có ứng viên trong quy trình AI</p>
            <p>Mở một vị trí tuyển dụng, bật Thiết lập AI, rồi chọn Thêm CV.</p>
        </field>
    </record>

    <record id="action_ai_log" model="ir.actions.act_window">
        <field name="name">AI Agent Activity</field>
        <field name="res_model">t10.ai.log</field>
        <field name="view_mode">list,pivot,graph</field>
    </record>

    <record id="ai_log_search" model="ir.ui.view">
        <field name="name">t10.ai.log.search</field>
        <field name="model">t10.ai.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="applicant_id"/>
                <field name="job_id"/>
                <filter name="handoffs" string="Agent handoffs" domain="[('to_agent', '!=', False)]"/>
                <group>
                    <filter name="by_agent" string="From" context="{'group_by': 'agent'}"/>
                    <filter name="by_to" string="To" context="{'group_by': 'to_agent'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="ai_log_list" model="ir.ui.view">
        <field name="name">t10.ai.log.list</field>
        <field name="model">t10.ai.log</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="create_date" string="When"/>
                <field name="job_id"/>
                <field name="applicant_id"/>
                <field name="agent" widget="badge"/>
                <field name="to_agent" widget="badge"/>
                <field name="message"/>
            </list>
        </field>
    </record>

    <menuitem id="menu_ai_root" name="AI Hiring Operator" parent="hr_recruitment.menu_hr_recruitment_root" sequence="2"/>
    <menuitem id="menu_ai_jobs" name="Job Setup" parent="menu_ai_root" action="hr_recruitment.action_hr_job_config" sequence="0" groups="base.group_no_one"/>
    <menuitem id="menu_ai_pipeline" name="Theo dõi ứng viên" parent="menu_ai_root" action="action_ai_pipeline" sequence="1"/>
    <menuitem id="menu_ai_log" name="Agent Activity" parent="menu_ai_root" action="action_ai_log" sequence="2" groups="base.group_no_one"/>
</odoo>
