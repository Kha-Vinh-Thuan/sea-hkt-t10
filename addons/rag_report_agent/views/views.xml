<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rag_report_form" model="ir.ui.view">
        <field name="name">rag.report.form</field>
        <field name="model">rag.report</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_compile" type="object" string="Compile Report" class="btn-primary"/>
                    <field name="overall_status" widget="statusbar"/>
                </header>
                <sheet>
                    <h1><field name="name"/></h1>
                    <group>
                        <field name="run_id"/>
                        <field name="candidate_id"/>
                        <field name="role_id"/>
                        <field name="role_version"/>
                        <field name="assignment"/>
                        <field name="report_status"/>
                    </group>
                    <notebook>
                        <page string="Report">
                            <field name="summary" readonly="1"/>
                            <field name="limitations" readonly="1"/>
                            <field name="open_items" readonly="1"/>
                            <field name="next_actions" readonly="1"/>
                        </page>
                        <page string="Input Bundle">
                            <field name="bundle"/>
                        </page>
                        <page string="Structured Output">
                            <field name="report_json" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rag_report" model="ir.actions.act_window">
        <field name="name">Evidence Reports</field>
        <field name="res_model">rag.report</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_rag_report" name="Evidence Reports" parent="hr_recruitment.menu_hr_recruitment_root"
              action="action_rag_report" sequence="42"/>
</odoo>
