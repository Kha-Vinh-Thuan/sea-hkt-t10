<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="recruitment_cards" model="ir.ui.view">
        <field name="name">hr.job.aho.cards</field><field name="model">hr.job</field>
        <field name="inherit_id" ref="hr_recruitment.view_hr_job_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//t[@t-name='card']" position="replace">
                <t t-name="card">
                    <main class="aho-job-card">
                        <div class="aho-job-heading"><div><div class="aho-job-title"><field name="name"/></div><div class="aho-job-meta"><field name="department_id"/></div></div><field name="is_favorite" widget="boolean_favorite" nolabel="1"/></div>
                        <div class="aho-job-meta"><field name="recruiter_id" widget="many2one_avatar_employee" options="{'display_avatar_name': True}"/></div>
                        <div class="aho-job-counts" groups="hr_recruitment.group_hr_recruitment_interviewer">
                            <div><strong><field name="new_application_count"/></strong><span>Hồ sơ mới</span></div>
                            <div><strong><field name="open_application_count"/></strong><span>Đang tuyển</span></div>
                            <div><strong><field name="no_of_recruitment"/></strong><span>Chỉ tiêu</span></div>
                        </div>
                        <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        <div class="aho-job-actions">
                            <button name="%(hr_recruitment.action_hr_job_applications)d" type="action" class="btn btn-primary">Xem ứng viên</button>
                            <button type="open" class="btn btn-secondary">Yêu cầu tuyển dụng</button>
                            <button name="action_open_activities" type="object" class="btn btn-link" groups="hr_recruitment.group_hr_recruitment_interviewer">Công việc</button>
                        </div>
                    </main>
                </t>
            </xpath>
        </field>
    </record>
    <record id="recruitment_search" model="ir.ui.view">
        <field name="name">hr.job.aho.search</field><field name="model">hr.job</field>
        <field name="inherit_id" ref="hr_recruitment.hr_job_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//searchpanel" position="replace"/></field>
    </record>
    <record id="hr_recruitment.action_hr_job" model="ir.actions.act_window">
        <field name="name">Tuyển dụng</field><field name="context">{'aho_pipeline': True}</field>
    </record>
</odoo>
