# Postgres from docker-compose (database "hr"). Tests use SQLite in memory and ignore this.
DATABASE_URL=postgresql+psycopg://odoo:odoo@localhost:5432/hr
# Where uploaded CV files are stored (gitignored).
UPLOAD_DIR=uploads
TIMEZONE=Asia/Ho_Chi_Minh

# Recruiter login. Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
RECRUITER_EMAIL=hr@example.com
RECRUITER_PASSWORD=

# Mail: defaults point at Mailpit from docker-compose (inbox at http://localhost:8025).
# Real Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_STARTTLS=true, SMTP_USER/SMTP_PASSWORD = app password.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=hr@example.com
