# Postgres from docker-compose (database "hr"). Tests use SQLite in memory and ignore this.
# Shared hosted Postgres (Neon / Supabase): paste the provider's URL as is, keep ?sslmode=require, e.g.
#   DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/hr?sslmode=require
# postgres:// and postgresql:// are switched to the psycopg driver automatically. See README "Shared hosted Postgres".
DATABASE_URL=postgresql+psycopg://odoo:odoo@localhost:5432/hr
# CV / attachment bytes now live in the DB (stored_file). This is only read by: python -m app.move_uploads_to_db
UPLOAD_DIR=uploads
TIMEZONE=Asia/Ho_Chi_Minh
# {company} in candidate email templates.
COMPANY_NAME=Our company

# Login. RECRUITER_EMAIL / RECRUITER_PASSWORD only seed the first admin when the user table is empty
# (first login); after that, manage users in the app (Users tab). Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_hex(32))"
# Each machine can keep its own SECRET_KEY on a shared DB; only share it if a token from one machine must work on another.
SECRET_KEY=
RECRUITER_EMAIL=hr@example.com
RECRUITER_PASSWORD=

# Mail: defaults point at Mailpit from docker-compose (inbox at http://localhost:8025).
# Real Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_STARTTLS=true, SMTP_USER/SMTP_PASSWORD = app password.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=hr@example.com

# Candidate-facing links (booking page, accept / decline) and the redirect after Google consent.
FRONTEND_URL=http://localhost:5173

# Google Calendar (optional; without it free slots come from our own interviews and no Meet links are made).
# Create the client: console.cloud.google.com > APIs & Services > Library > enable "Google Calendar API";
# OAuth consent screen (External, add each recruiter/interviewer as a test user while unpublished);
# Credentials > Create credentials > OAuth client ID > Web application.
# "Authorized redirect URIs" must contain exactly http://localhost:8000/api/google/callback (= GOOGLE_REDIRECT_URI).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/google/callback
